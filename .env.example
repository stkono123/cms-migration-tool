# =====================================================================
# MigrateIQ — Environment Variables
# Copy this file to .env.local for local dev, or paste into Vercel.
# =====================================================================

# --- App authentication (Basic Auth, all routes) --------------------
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=changeme

# --- Anthropic / Claude API -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Contentful (Management API) ------------------------------------
# Space ID — ACN sandbox: fyjzhpi1por3
CONTENTFUL_SPACE_ID=fyjzhpi1por3
# Environment name — ACN sandbox uses "empty-environment"; personal uses "master"
CONTENTFUL_ENVIRONMENT=empty-environment
# Personal Access Token from Contentful → Space Settings → API Keys → CMA tokens
CONTENTFUL_CMA_TOKEN=CFPAT-...

# --- commercetools (optional — leave blank to skip CT target) -------
CT_PROJECT_KEY=
CT_CLIENT_ID=
CT_CLIENT_SECRET=
# Defaults to europe-west1/GCP if not set
CT_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CT_API_URL=https://api.europe-west1.gcp.commercetools.com

# --- Shopify (optional — leave blank to skip Shopify source) --------
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_DOMAIN=
# Required only for the OAuth callback flow
SHOPIFY_CLIENT_SECRET=
